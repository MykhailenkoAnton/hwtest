build/
build*/
cmake-build-*/

# Ignore generated CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# ==========================================
# Local/User Configuration Presets
# ==========================================
# NEVER track user local presets, but KEEP your shared CMakePresets.json if you have one
CMakeUserPresets.json